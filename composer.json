{
    "name": "jiri/ai-image-block-for-nanogpt",
    "description": "Gutenberg block that generates images with NanoGPT through the WordPress AI Client.",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "php-parallel-lint/php-parallel-lint": "^1.4",
        "phpstan/phpstan": "^1.12",
        "szepeviktor/phpstan-wordpress": "^1.3",
        "wordpress/php-ai-client": "^0.4 || dev-trunk"
    },
    "autoload": {
        "psr-4": {
            "WordPress\\NanoGptAiImageBlock\\": "includes/"
        }
    },
    "config": {
        "platform": {
            "php": "7.4"
        },
        "sort-packages": true
    },
    "scripts": {
        "lint": "parallel-lint --exclude vendor --exclude node_modules .",
        "stan": "phpstan analyse --memory-limit=512M"
    }
}
