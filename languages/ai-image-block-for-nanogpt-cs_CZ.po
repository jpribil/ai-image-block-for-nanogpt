msgid "The WordPress AI Client is not available."
msgstr "Klient WordPress AI není k dispozici."

msgid "A prompt is required."
msgstr "Je vyžadován prompt."

msgid "A model is required."
msgstr "Je vyžadován model."

msgid "The generated image contained no data."
msgstr "Vygenerovaný obrázek neobsahoval žádná data."

msgid "The generated image could not be decoded."
msgstr "Vygenerovaný obrázek se nepodařilo dekódovat."

msgid "Could not create a temporary file for the image."
msgstr "Nepodařilo se vytvořit dočasný soubor pro obrázek."

msgid "Could not write the generated image to disk."
msgstr "Nepodařilo se zapsat vygenerovaný obrázek na disk."

msgid "The generated image had no URL."
msgstr "Vygenerovaný obrázek neměl URL."

msgid "Select a model…"
msgstr "Vyberte model…"

msgid "Provider default"
msgstr "Výchozí nastavení poskytovatele"

msgid "Prompt"
msgstr "Prompt"

msgid "Describe the image you want to create."
msgstr "Popište obrázek, který chcete vytvořit."

msgid "Model"
msgstr "Model"

msgid "Image size"
msgstr "Velikost obrázku"

msgid "Choose Provider default to let NanoGPT decide."
msgstr "Pro ponechání na NanoGPT zvolte Výchozí nastavení poskytovatele."

msgid "Estimated price:"
msgstr "Odhadovaná cena:"

msgid "per image"
msgstr "za obrázek"

msgid "Could not load the model list."
msgstr "Nepodařilo se načíst seznam modelů."

msgid "Image generation failed."
msgstr "Generování obrázku selhalo."

msgid "Generation settings"
msgstr "Nastavení generování"

msgid "Regenerate"
msgstr "Přegenerovat"

msgid "AI Image (NanoGPT)"
msgstr "AI obrázek (NanoGPT)"

msgid "Describe the image, pick a model and size, then generate."
msgstr "Popište obrázek, vyberte model a velikost a vygenerujte."

msgid "Generate image"
msgstr "Vygenerovat obrázek"
