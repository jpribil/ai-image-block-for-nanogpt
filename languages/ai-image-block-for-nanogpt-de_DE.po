msgid "The WordPress AI Client is not available."
msgstr "Der WordPress-AI-Client ist nicht verfügbar."

msgid "A prompt is required."
msgstr "Ein Prompt ist erforderlich."

msgid "A model is required."
msgstr "Ein Modell ist erforderlich."

msgid "The generated image contained no data."
msgstr "Das generierte Bild enthielt keine Daten."

msgid "The generated image could not be decoded."
msgstr "Das generierte Bild konnte nicht dekodiert werden."

msgid "Could not create a temporary file for the image."
msgstr "Es konnte keine temporäre Datei für das Bild erstellt werden."

msgid "Could not write the generated image to disk."
msgstr "Das generierte Bild konnte nicht auf die Festplatte geschrieben werden."

msgid "The generated image had no URL."
msgstr "Das generierte Bild hatte keine URL."

msgid "Select a model…"
msgstr "Modell auswählen…"

msgid "Provider default"
msgstr "Standard des Anbieters"

msgid "Prompt"
msgstr "Prompt"

msgid "Describe the image you want to create."
msgstr "Beschreiben Sie das Bild, das Sie erstellen möchten."

msgid "Model"
msgstr "Modell"

msgid "Image size"
msgstr "Bildgröße"

msgid "Choose Provider default to let NanoGPT decide."
msgstr "Wählen Sie „Standard des Anbieters“, damit NanoGPT entscheidet."

msgid "Estimated price:"
msgstr "Geschätzter Preis:"

msgid "per image"
msgstr "pro Bild"

msgid "Could not load the model list."
msgstr "Die Modellliste konnte nicht geladen werden."

msgid "Image generation failed."
msgstr "Die Bilderzeugung ist fehlgeschlagen."

msgid "Generation settings"
msgstr "Generierungseinstellungen"

msgid "Regenerate"
msgstr "Neu generieren"

msgid "AI Image (NanoGPT)"
msgstr "KI-Bild (NanoGPT)"

msgid "Describe the image, pick a model and size, then generate."
msgstr "Beschreiben Sie das Bild, wählen Sie Modell und Größe und generieren Sie."

msgid "Generate image"
msgstr "Bild generieren"
